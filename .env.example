# Copier en `.env` et renseigner. Le fichier `.env` n'est jamais versionné.
## Environment variables for:
## ---- PostgreSQL ----
## PostgreSQL Database name   : DB_NAME (default db)
## PostgreSQL Database user   : DB_USER (default duser)
## PostgreSQL Server password : DB_PASSWORD (default dbpassword)

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT_HOTE=5432
DB_NAME=churn
DB_USER=churn
DB_PASSWORD=changeme

# MLFlow Configuration : port publié sur le poste (le serveur écoute sur 5000 dans
# son conteneur ; 5100 ici évite un conflit avec `make mlflow`, qui utilise 5000).
MLFLOW_PORT=5100

# API configuration

# GRAFANA
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme


# PROMETHEUS
PROMETHEUS_PORT=9090


# Docker image tag for the churn-saas-api service
IMAGE_TAG=v1.0

# API key(s) for the X-API-Key header, comma-separated to rotate without downtime.
CHURN_API_KEY=changez-moi
