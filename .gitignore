# Environnement
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest-tmp/

# Données
#
# data/raw/      versionné dans Git : sources de l'énoncé, 2 Mo au total, et c'est la
#                référence à partir de laquelle tout se recalcule.
# data/processed/ NON versionné : instantanés dérivés, recalculables depuis les sources et
#                le code. Les versionner produirait un diff binaire à chaque modification
#                des règles de nettoyage, pour une information déjà contenue ailleurs.
#                Ce que Git conserve est le manifeste : petit, textuel, et c'est lui le
#                contrat (voir docs/00.README_choix_methodologiques.md § 3).
data/processed/*
data/interim/*
!data/**/.gitkeep

# Modèles sérialisés — artefacts de build, non versionnés dans Git
models/*
!models/.gitkeep

# Sorties
reports/figures/*
!reports/figures/.gitkeep
# Données — versionnées hors dépôt (voir docs/README_choix_methodologiques.md § 3)
#         - Choix technique : mis dans Git-LFS
# emissions.csv

# Outils
.pytest_cache/
.ruff_cache/
.env
# Artefacts d'échange Git : bundles et patchs se régénèrent, ils n'ont pas à
# vivre dans l'historique qu'ils servent à transporter.
*.bundle
*.patch
.catalogue-tests-tmp.md
.venv-ci/
